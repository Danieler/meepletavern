generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GameStatus {
  draft
  review
  published
  archived
}

enum GameCandidateStatus {
  pending
  needs_review
  approved
  rejected
  converted
}

enum EditorialFlag {
  possible_duplicate
  missing_players
  missing_playtime
  missing_age
  image_not_allowed
  low_confidence
  needs_permission
}

enum MediaAssetType {
  cover
  box
  component
  placeholder
}

enum MediaAssetStatus {
  candidate
  approved
  rejected
}

enum MediaAssetUsage {
  public
  admin_only
  purchase_only
}

enum TaxonomyType {
  category
  mechanic
  theme
}

enum GameImageStatus {
  verified
  missing
  placeholder
  needs_review
}

enum GameImportProposalStatus {
  pending
  applied
  rejected
}

model Game {
  id                    String          @id @default(cuid())
  name                  String
  slug                  String          @unique
  status                GameStatus      @default(draft)
  title                 String          @default("")
  originalTitle         String?
  year                  Int?
  players               Json            @default("{}")
  imageUrl              String?
  coverImageUrl         String?
  coverImageAlt         String          @default("")
  imageSourceName       String?
  imageSourceUrl        String?
  imageLicenseNote      String?
  imageStatus           GameImageStatus @default(missing)
  description           String?
  review                String?
  shortSummary          String?
  shortDescription      String?
  quickVerdict          String?
  pros                  String[]        @default([])
  cons                  String[]        @default([])
  bestFor               String?
  notFor                String?
  minPlayers            Int?
  maxPlayers            Int?
  playtime              String?
  age                   String?
  minAge                Int?
  complexity            String?
  difficulty            String?
  categories            String[]        @default([])
  mechanics             String[]        @default([])
  themes                String[]        @default([])
  publisher             String?
  spanishPublisher      String?
  similarGames          String[]        @default([])
  faqs                  Json?
  faq                   Json?
  seoTitle              String?
  seoDescription        String?
  buyUrl                String?
  ratings               Json            @default("{}")
  howToPlayVideos       Json            @default("[]")
  sources               Json?
  sourceIds             String[]        @default([])
  primaryImageId        String?
  imageFallbackAccepted Boolean         @default(false)
  createdByAi           Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  publishedAt           DateTime?
  mediaAssets           MediaAsset[]
  candidates            GameCandidate[]
  libraryEntries        UserLibraryGame[]
  userRatings           UserGameRating[]
  userPlayCounts        UserGamePlayCount[]
  reviews               Review[]
  comments              GameComment[]
  activityEvents        ActivityEvent[]
  listItems             GameListItem[]
  ruleQuestions         RuleQuestion[]
  importProposals       GameImportProposal[]
  offers                GameOffer[]

  @@index([status])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Game_name_trgm_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Game_title_trgm_idx")
}

model GameImportProposal {
  id               String                 @id @default(cuid())
  gameId           String
  game             Game                   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  provider         String
  status           GameImportProposalStatus @default(pending)
  query            String
  rawSearchResults Json
  extractedFields  Json
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([gameId, status])
  @@index([createdAt])
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id          String   @id @default(cuid())
  authUserId  String   @unique
  email       String   @unique
  displayName String?
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     UserProfile?
  library     UserLibraryGame[]
  gameRatings UserGameRating[]
  gamePlayCounts UserGamePlayCount[]
  reviews     Review[]
  comments    GameComment[]
  activityEvents ActivityEvent[]
  gameLists   GameList[]
  gameSuggestions GameSuggestion[]
  ruleQuestions RuleQuestion[]
  ruleAnswers   RuleAnswer[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  username    String @unique
  displayName String?
  bio         String?
  avatarUrl   String?

  profileVisibility    ProfileVisibility @default(PUBLIC)
  collectionVisibility ProfileVisibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileVisibility, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([username(ops: raw("gin_trgm_ops"))], type: Gin, map: "UserProfile_username_trgm_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "UserProfile_displayName_trgm_idx")
}

enum ActivityEventType {
  COLLECTION_ADDED
  WANT_TO_PLAY
  PLAYED
  RATED
  COMMENTED
  GAME_TRENDING
  WEEKLY_SUMMARY
  LIST_CREATED
  LIST_GAME_ADDED
}

enum ActivityEventVisibility {
  PUBLIC
  PRIVATE
}

model ActivityEvent {
  id                     String                  @id @default(cuid())
  type                   ActivityEventType
  actorUserId            String?
  actorUser              User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorNameSnapshot      String?
  actorUsernameSnapshot  String?
  actorAvatarUrlSnapshot String?
  gameId                 String?
  game                   Game?                   @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameTitleSnapshot      String?
  gameSlugSnapshot       String?
  listTitleSnapshot      String?
  listSlugSnapshot       String?
  rating                 Int?
  commentSnippet         String?
  metadata               Json?
  visibility             ActivityEventVisibility @default(PUBLIC)
  dedupeKey              String?                 @unique
  createdAt              DateTime                @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([gameId, createdAt(sort: Desc)])
  @@index([visibility, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorNameSnapshot(ops: raw("gin_trgm_ops"))], type: Gin, map: "ActivityEvent_actorNameSnapshot_trgm_idx")
  @@index([actorUsernameSnapshot(ops: raw("gin_trgm_ops"))], type: Gin, map: "ActivityEvent_actorUsernameSnapshot_trgm_idx")
  @@index([gameTitleSnapshot(ops: raw("gin_trgm_ops"))], type: Gin, map: "ActivityEvent_gameTitleSnapshot_trgm_idx")
  @@index([listTitleSnapshot(ops: raw("gin_trgm_ops"))], type: Gin, map: "ActivityEvent_listTitleSnapshot_trgm_idx")
}

enum GameListVisibility {
  PUBLIC
  PRIVATE
}

enum GameSuggestionStatus {
  PENDING
  REVIEWED
  IMPORTED
  REJECTED
}

model GameList {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  visibility  GameListVisibility @default(PRIVATE)
  isDefault   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       GameListItem[]

  @@unique([userId, slug])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([visibility, updatedAt(sort: Desc)])
}

model GameListItem {
  id      String   @id @default(cuid())
  listId  String
  list    GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  gameId  String
  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@unique([listId, gameId])
  @@index([listId, addedAt(sort: Desc), id(sort: Desc)])
  @@index([gameId])
}

model GameSuggestion {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  url            String?
  notes          String?
  status         GameSuggestionStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, normalizedName])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model Review {
  id             String   @id @default(cuid())
  gameId          String
  userId          String?
  authorName      String
  title           String
  slug            String   @unique
  summary         String
  body            String
  isApproved      Boolean  @default(false)
  instagramPostId String?
  instagramHashtags String?
  createdByAdmin  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime @default(now())
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gameId, publishedAt])
  @@index([userId, createdAt])
  @@index([publishedAt])
}

model GameComment {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, updatedAt])
  @@index([userId, updatedAt])
}

model UserGameRating {
  userId    String
  gameId    String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId, updatedAt])
  @@index([userId, updatedAt])
}

model UserLibraryGame {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  
  owned      Boolean @default(false)
  wantToPlay Boolean @default(false)
  wantToBuy  Boolean @default(false)
  played     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
  @@index([gameId])
  @@index([gameId, owned])
  @@index([gameId, wantToPlay])
  @@index([gameId, played])
  @@index([gameId, updatedAt])
}

model UserGamePlayCount {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId], map: "UserGamePlayCount_userId_gameId_key")
  @@index([userId], map: "UserGamePlayCount_userId_idx")
  @@index([gameId], map: "UserGamePlayCount_gameId_idx")
}

model Source {
  id         String          @id @default(cuid())
  name       String
  baseUrl    String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  candidates GameCandidate[]
  mediaAssets MediaAsset[]
  offers      GameOffer[]

  @@index([createdAt])
}

model GameCandidate {
  id                   String              @id @default(cuid())
  sourceId             String
  source               Source              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceUrl            String
  title                String
  originalTitle        String?
  gameId               String?
  game                 Game?               @relation(fields: [gameId], references: [id], onDelete: SetNull)
  metadata             Json                @default("{}")
  extractedDescription String?
  candidateImages      Json                @default("[]")
  aiDraft              Json?
  aiGenerated          Boolean             @default(false)
  aiReviewed           Boolean             @default(false)
  confidence           Float               @default(0)
  status               GameCandidateStatus @default(pending)
  flags                EditorialFlag[]     @default([])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  mediaAssets          MediaAsset[]
  offers               GameOffer[]

  @@index([sourceId])
  @@index([gameId])
  @@index([status])
  @@index([createdAt])
}

model GameOffer {
  id                String         @id @default(cuid())
  gameId            String?
  game              Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  candidateId       String?
  candidate         GameCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  sourceId          String?
  source            Source?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceName        String
  sourceDisplayName String?
  storeName         String?
  titleAtSource     String?
  price             Float?
  currency          String?
  availability      String?
  purchaseUrl       String?
  affiliateUrl      String?
  sourceUrl         String?
  externalId        String?
  rawData           Json?
  fetchedAt         DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([gameId])
  @@index([candidateId])
  @@index([sourceId])
  @@index([sourceName])
  @@index([fetchedAt])
}

model MediaAsset {
  id          String           @id @default(cuid())
  gameId      String?
  game        Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  candidateId String?
  candidate   GameCandidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  sourceId    String?
  source      Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  url         String
  localPath   String?
  type        MediaAssetType
  status      MediaAssetStatus @default(candidate)
  usage       MediaAssetUsage  @default(admin_only)
  attribution String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([gameId])
  @@index([candidateId])
  @@index([sourceId])
  @@index([status])
  @@index([usage])
}

model TaxonomyTerm {
  id        String       @id @default(cuid())
  type      TaxonomyType
  name      String
  slug      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([type, slug])
  @@index([type])
}

model RuleQuestion {
  id        String       @id @default(cuid())
  gameId    String
  userId    String
  title     String       @db.VarChar(150)
  body      String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   RuleAnswer[]

  @@index([gameId, createdAt(sort: Desc)])
}

model RuleAnswer {
  id         String       @id @default(cuid())
  questionId String
  userId     String
  body       String       @db.Text
  isAccepted Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  question   RuleQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt(sort: Asc)])
}
